OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Persistence (Phase 7). Leave unset or set CASE_REPOSITORY=memory for in-memory.
# Never put SUPABASE_SERVICE_ROLE_KEY in NEXT_PUBLIC_* variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CASE_REPOSITORY=memory

# Opt-in live Supabase integration tests only (never production credentials):
# RUN_SUPABASE_INTEGRATION=1

# Explicit demo seed only (CLI: npm run seed:demo, or POST /api/demo/seed). Never auto-runs.
# ALLOW_DEMO_SEED=1
