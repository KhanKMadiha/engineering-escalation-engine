OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Persistence (Phase 7). Leave unset or set CASE_REPOSITORY=memory for in-memory.
# Never put SUPABASE_SERVICE_ROLE_KEY in NEXT_PUBLIC_* variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CASE_REPOSITORY=memory

# Opt-in live Supabase integration tests only (never production credentials):
# RUN_SUPABASE_INTEGRATION=1
# For Phase 3A, use `.env.staging` + `npm run test:supabase:staging`
# (never point those tests at production ref zfpakilfxnwhlcfjgemw).

# Explicit demo seed only (CLI: npm run seed:demo, or POST /api/demo/seed). Never auto-runs.
# ALLOW_DEMO_SEED=1

# Signed anonymous demo workspace cookies (Approach D). Required in hosted deploys.
# DEMO_WORKSPACE_SECRET=

# Emergency kill-switch for anonymous CoW / simulated approvals / Jira+Rootly writes.
# Unset or "1" = allowed. Set to "0" / "false" / "off" / "disabled" to freeze demo
# mutations while keeping the Case Queue and shared templates readable.
# DEMO_INTERACTIVE_WRITES=1

# Isolated staging (copy from .env.staging.example → .env.staging; gitignored):
# SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# DEMO_WORKSPACE_SECRET=
