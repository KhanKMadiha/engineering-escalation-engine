# Isolated staging only — never copy production credentials here.
# Copy to `.env.staging` (gitignored) after creating a non-production Supabase project.
# `.env.local` must remain untouched if it points at production.
#
# Phase 3A migrations: apply baseline + CoW/downstream only.
# Skip 20261122120000_assessment_versions_and_multi_decisions.sql unless
# intentionally testing that separate feature.

# Must NOT be project ref zfpakilfxnwhlcfjgemw
SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
CASE_REPOSITORY=supabase

# Required for Phase 3A cookie + workspace tests (staging-only random secret)
DEMO_WORKSPACE_SECRET=

# Opt-in live DB tests (set by `npm run test:supabase:staging`)
# RUN_SUPABASE_INTEGRATION=1

# Optional: seed fictional demos against staging only
# ALLOW_DEMO_SEED=1
